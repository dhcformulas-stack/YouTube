# Server
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_PATH=./data/chronicle-forge.db

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (created via Stripe dashboard or setup script)
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_INTERMEDIATE=price_intermediate_monthly
STRIPE_PRICE_GOLD=price_gold_monthly

# Admin credentials (seeded on first startup)
ADMIN_EMAIL=admin@chronicleforge.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000