# Chronicle Forge — pipeline environment variables
#
# Copy to .env (never commit real values) and export before running, or pass
# them through your process manager. EVERY variable here is optional: with
# `--offline` (or PIPELINE_OFFLINE=1) the pipeline runs with no keys at all and
# produces a real MP4 from deterministic stubs.
#
# Which key enables which stage
# ---------------------------------------------------------------------------
# PERPLEXITY_API_KEY   research stage — LLM with live web search. PREFERRED,
#                      because the brief comes back with real citations.
# OPENAI_API_KEY       script stage (required online); image stage (required
#                      online); narration fallback (TTS); research fallback
#                      (no live web search).
# ELEVENLABS_API_KEY   narration stage, preferred over OpenAI TTS.
#
# Nothing else is required. Without at least one of the keys above the pipeline
# refuses to run in online mode (it will NOT quietly produce a stub for a
# paying customer).

# --- mode -----------------------------------------------------------------
# 1 = offline deterministic stubs (dev/CI). Same as --offline.
PIPELINE_OFFLINE=0

# --- research -------------------------------------------------------------
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
# Fallback research provider when PERPLEXITY_API_KEY is unset (no web search).
OPENAI_RESEARCH_MODEL=gpt-4o-mini

# --- OpenAI (shared by script, images, optional TTS + research fallback) ---
OPENAI_API_KEY=
# Override only for a compatible gateway / proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- script ---------------------------------------------------------------
SCRIPT_MODEL=gpt-4o-mini
SCRIPT_TEMPERATURE=0.7
SCRIPT_MAX_TOKENS=3000

# --- narration ------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx

# --- images ---------------------------------------------------------------
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
# Style suffix appended to every cue prompt, for a consistent look.
IMAGE_STYLE=

# --- editorial ------------------------------------------------------------
TARGET_MINUTES=30
WORDS_PER_MINUTE=140
CHAPTERS=8

# --- video ----------------------------------------------------------------
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_CRF=23
VIDEO_PRESET=veryfast
AUDIO_BITRATE=192k
# Stills per encode batch. Lower it if renders are killed on a small host.
VIDEO_BATCH_SIZE=10
MIN_SCENE_SECONDS=1.5
# Path to ffmpeg if it is not on PATH (e.g. imageio-ffmpeg's bundled binary).
FFMPEG_BIN=

# --- resilience -----------------------------------------------------------
HTTP_TIMEOUT=180
MAX_RETRIES=3
